flowchart TD
  A(["上电或复位"]) --> B["初始化系统时钟、中断与延时"]
  B --> C["初始化串口、传感器、按键与执行器"]
  C --> D["初始化 OLED、ADC、机智云与定时器<br/>启用独立看门狗"]
  D --> E["读取系统时间与按键事件"]
  E --> F{"首次采样或间隔达到1000 ms？"}
  F -->|是| G["更新温湿度、光照和烟雾<br/>尝试非阻塞发送环境遥测"]
  F -->|否| H["处理配网请求与短时提示"]
  G --> H
  H --> I["处理串口命令、模式同步及自动控制"]
  I --> J["心跳推进时刷新看门狗"]
  J --> K["处理菜单、按键与 OLED 刷新"]
  K --> L["提交窗户待执行目标并清除标志"]
  L --> M["准备数据点并调用机智云协议处理"]
  M --> E

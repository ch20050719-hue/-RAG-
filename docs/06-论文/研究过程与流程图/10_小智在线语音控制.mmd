flowchart TD
  A(["用户提出在线语音请求"]) --> B["小智平台处理语音并调用设备工具"]
  B --> C{"工具类型？"}
  C -->|设备控制| D{"设备与开关参数符合限定？"}
  C -->|模式或场景| E{"模式在固定列表中？"}
  D -->|否| X["返回参数错误"]
  E -->|否| X
  D -->|是| F["生成前置手动帧<br/>再生成设备动作帧"]
  E -->|是| G["生成对应模式或场景帧"]
  F --> H{"串口发送队列接受请求？"}
  G --> H
  H -->|否| Y["返回入队失败"]
  H -->|是| I["返回已入队状态"]
  I --> J["发送任务经 UART 输出到 STM32 USART3"]
  J --> K["STM32 解析并执行模式或目标更新"]
  K --> Z(["等待后续用户请求"])
  X --> Z
  Y --> Z

flowchart TD
  A(["自动控制入口"]) --> B{"配网提示暂停自动处理？"}
  B -->|是| Z(["返回主循环"])
  B -->|否| C{"当前为自动模式？"}
  C -->|否| Z
  C -->|是| D["按有效位更新温湿度、光照与烟雾条件<br/>应用各自触发阈值和恢复滞回"]
  D --> E{"温湿度数据有效？"}
  E -->|是| F["湿度触发则请求开窗<br/>湿度恢复则请求关窗"]
  E -->|否| G{"存在有效温度、湿度或烟雾触发？"}
  F --> G
  G -->|是| H["开启风扇与蜂鸣器"]
  G -->|否| I{"温湿度和 ADC 两组均有效？"}
  I -->|是| J["关闭风扇与蜂鸣器"]
  I -->|否| K["保持相关输出"]
  H --> L{"ADC 组有效？"}
  J --> L
  K --> L
  L -->|是| M["低光照条件触发则开灯<br/>条件恢复则关灯"]
  L -->|否| Z
  M --> Z
